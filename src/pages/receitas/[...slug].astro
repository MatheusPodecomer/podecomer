---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const receitas = await getCollection('receitas');
  return receitas.map((receita) => ({
    params: { slug: receita.slug },
    props: { receita },
  }));
}

const { receita } = Astro.props;
const { Content } = await receita.render();
---
<Layout title={receita.data.title}>
  <p><a href="/receitas" class="voltar">← Voltar para todas as receitas</a></p>
  <span class="tag">{receita.data.categoria}</span>
  <h1>{receita.data.title}</h1>
  {receita.data.imagem && (
    <img src={receita.data.imagem} alt={receita.data.title} class="foto-receita" />
  )}
  <p class="descricao">{receita.data.descricao}</p>
  <div class="conteudo">
    <Content />
  </div>

  {receita.data.produtos && receita.data.produtos.length > 0 && (
    <div class="produtos">
      <p class="produtos-titulo">Produtos usados nesta receita</p>
      <ul>
        {receita.data.produtos.map((produto) => (
          <li>
            <a href={produto.url} rel="sponsored noopener" target="_blank">
              {produto.nome}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}

  <style>
    .voltar {
      color: var(--terracota);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.9rem;
    }
    h1 {
      color: var(--marrom);
      margin: 0.75rem 0 0.5rem;
    }
    .foto-receita {
      width: 100%;
      max-height: 380px;
      object-fit: cover;
      border-radius: 18px;
      margin-bottom: 1.25rem;
      box-shadow: 0 4px 14px rgba(58, 42, 30, 0.12);
    }
    .descricao {
      color: #6b5a4a;
      font-size: 1.05rem;
      margin-bottom: 1.5rem;
    }
    .conteudo {
      background: white;
      border-radius: 18px;
      padding: 1.75rem;
      box-shadow: 0 4px 14px rgba(58, 42, 30, 0.08);
    }
    .conteudo :global(h2) {
      color: var(--marrom);
      margin-top: 1.5rem;
    }
    .conteudo :global(h2:first-child) {
      margin-top: 0;
    }
    .conteudo :global(ul), .conteudo :global(ol) {
      padding-left: 1.25rem;
    }
    .conteudo :global(li) {
      margin-bottom: 0.35rem;
    }
    .produtos {
      margin-top: 1.5rem;
      padding-top: 1rem;
      border-top: 1px solid var(--creme-forte);
    }
    .produtos-titulo {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #9a8a7a;
      margin: 0 0 0.5rem;
    }
    .produtos ul {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .produtos a {
      display: inline-block;
      font-size: 0.85rem;
      color: var(--terracota);
      background: var(--creme-forte);
      border-radius: 999px;
      padding: 0.35rem 0.9rem;
      text-decoration: none;
    }
    .produtos a:hover {
      text-decoration: underline;
    }
  </style>
</Layout>
