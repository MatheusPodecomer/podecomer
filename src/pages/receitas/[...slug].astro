---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const receitas = await getCollection('receitas');
  return receitas.map((receita) => ({
    params: { slug: receita.slug },
    props: { receita },
  }));
}

const { receita } = Astro.props;
const { Content } = await receita.render();
---
<Layout title={receita.data.title}>
  <p><a href="/receitas" class="voltar">← Voltar para todas as receitas</a></p>
  <span class="tag">{receita.data.categoria}</span>
  <h1>{receita.data.title}</h1>
  {receita.data.imagem && (
    <img src={receita.data.imagem} alt={receita.data.title} class="foto-receita" />
  )}
  <p class="descricao">{receita.data.descricao}</p>
  <div class="conteudo">
    <Content />
  </div>

  <style>
    .voltar {
      color: var(--terracota);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.9rem;
    }
    h1 {
      color: var(--marrom);
      margin: 0.75rem 0 0.5rem;
    }
    .foto-receita {
      width: 100%;
      max-height: 380px;
      object-fit: cover;
      border-radius: 18px;
      margin-bottom: 1.25rem;
      box-shadow: 0 4px 14px rgba(58, 42, 30, 0.12);
    }
    .descricao {
      color: #6b5a4a;
      font-size: 1.05rem;
      margin-bottom: 1.5rem;
    }
    .conteudo {
      background: white;
      border-radius: 18px;
      padding: 1.75rem;
      box-shadow: 0 4px 14px rgba(58, 42, 30, 0.08);
    }
    .conteudo :global(h2) {
      color: var(--marrom);
      margin-top: 1.5rem;
    }
    .conteudo :global(h2:first-child) {
      margin-top: 0;
    }
    .conteudo :global(ul), .conteudo :global(ol) {
      padding-left: 1.25rem;
    }
    .conteudo :global(li) {
      margin-bottom: 0.35rem;
    }
  </style>
</Layout>
