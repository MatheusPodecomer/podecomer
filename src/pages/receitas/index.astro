---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const receitas = await getCollection('receitas');
---
<Layout title="Receitas">
  <h1>Todas as receitas</h1>

  <div class="busca-wrap">
    <input
      type="text"
      id="busca-receitas"
      placeholder="🔍 Buscar por nome ou categoria..."
      autocomplete="off"
    />
  </div>

  <p id="sem-resultados" class="sem-resultados">Nenhuma receita encontrada.</p>

  <div class="cards" id="lista-receitas">
    {receitas.map((receita) => (
      <a
        href={`/receitas/${receita.slug}`}
        class="card"
        data-title={receita.data.title.toLowerCase()}
        data-categoria={receita.data.categoria.toLowerCase()}
      >
        <span class="tag">{receita.data.categoria}</span>
        <h3>{receita.data.title}</h3>
        <p>{receita.data.descricao}</p>
      </a>
    ))}
  </div>

  <style>
    h1 {
      color: var(--marrom);
      margin-bottom: 1rem;
    }
    .busca-wrap {
      margin-bottom: 1.5rem;
    }
    #busca-receitas {
      width: 100%;
      padding: 0.85rem 1.25rem;
      border-radius: 999px;
      border: 2px solid var(--creme-forte);
      background: white;
      font-size: 1rem;
      font-family: 'Nunito Sans', sans-serif;
      color: var(--texto);
      outline: none;
      transition: border-color 0.2s ease;
    }
    #busca-receitas:focus {
      border-color: var(--mostarda);
    }
    .sem-resultados {
      display: none;
      text-align: center;
      color: #8a7a6a;
      padding: 1rem 0;
    }
    .cards {
      display: grid;
      gap: 1.25rem;
    }
    .card {
      display: block;
      background: white;
      border-radius: 18px;
      padding: 1.5rem;
      text-decoration: none;
      color: var(--texto);
      box-shadow: 0 4px 14px rgba(58, 42, 30, 0.08);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(58, 42, 30, 0.14);
    }
    .card h3 {
      margin: 0.6rem 0 0.4rem;
      font-size: 1.15rem;
      color: var(--marrom);
    }
    .card p {
      margin: 0;
      font-size: 0.92rem;
      color: #6b5a4a;
    }
  </style>

  <script>
    const input = document.getElementById('busca-receitas') as HTMLInputElement;
    const cards = document.querySelectorAll<HTMLElement>('#lista-receitas .card');
    const semResultados = document.getElementById('sem-resultados') as HTMLElement;

    function aplicarFiltro(termo: string) {
      const termoNormalizado = termo.toLowerCase().trim();
      let visiveis = 0;

      cards.forEach((card) => {
        const titulo = card.getAttribute('data-title') || '';
        const categoria = card.getAttribute('data-categoria') || '';
        const match = titulo.includes(termoNormalizado) || categoria.includes(termoNormalizado);
        card.style.display = match ? '' : 'none';
        if (match) visiveis++;
      });

      semResultados.style.display = visiveis === 0 ? 'block' : 'none';
    }

    // Se a pessoa veio da busca da página inicial (ex: /receitas?q=bolo)
    const params = new URLSearchParams(window.location.search);
    const termoInicial = params.get('q');
    if (termoInicial) {
      input.value = termoInicial;
      aplicarFiltro(termoInicial);
    }

    input.addEventListener('input', () => {
      aplicarFiltro(input.value);
    });
  </script>
</Layout>
