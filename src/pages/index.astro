---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const receitas = await getCollection('receitas');
const destaques = receitas.slice(0, 3);
---
<Layout title="Início">
  <section class="hero">
    <span class="tag">Feito com carinho</span>
    <h1>Saboroso, seguro<br />e sem restrição de sabor</h1>
    <p>
      Receitas testadas e pensadas pra quem tem restrições alimentares —
      sem lactose, sem glúten e muito mais. Aqui você encontra o que
      <strong>pode comer</strong>, sem complicação.
    </p>

    <form action="/receitas" method="get" class="busca-form">
      <input
        type="text"
        name="q"
        placeholder="🔍 Buscar por nome ou categoria..."
        autocomplete="off"
      />
      <button type="submit">Buscar</button>
    </form>

    <a href="/receitas" class="btn-pill solid">Ver Receitas</a>
  </section>

  {destaques.length > 0 && (
    <section class="destaques">
      <h2>Receitas em destaque</h2>
      <div class="cards">
        {destaques.map((receita) => (
          <a href={`/receitas/${receita.slug}`} class="card">
            <span class="tag">{receita.data.categoria}</span>
            <h3>{receita.data.title}</h3>
            <p>{receita.data.descricao}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <style>
    .hero {
      text-align: center;
      padding: 2rem 1rem 3rem;
    }
    .hero h1 {
      font-size: 2.4rem;
      line-height: 1.15;
      margin: 1rem 0;
      color: var(--marrom);
    }
    .hero p {
      max-width: 480px;
      margin: 0 auto 1.75rem;
      color: #5c4a3a;
    }
    .busca-form {
      display: flex;
      gap: 0.5rem;
      max-width: 420px;
      margin: 0 auto 1.75rem;
    }
    .busca-form input {
      flex: 1;
      padding: 0.75rem 1.1rem;
      border-radius: 999px;
      border: 2px solid var(--creme-forte);
      background: white;
      font-size: 0.95rem;
      font-family: 'Nunito Sans', sans-serif;
      color: var(--texto);
      outline: none;
      transition: border-color 0.2s ease;
    }
    .busca-form input:focus {
      border-color: var(--mostarda);
    }
    .busca-form button {
      padding: 0.75rem 1.25rem;
      border-radius: 999px;
      border: none;
      background: var(--mostarda);
      color: var(--marrom);
      font-weight: 700;
      font-family: 'Fraunces', serif;
      cursor: pointer;
      transition: background 0.2s ease;
    }
    .busca-form button:hover {
      background: var(--mostarda-escura);
      color: white;
    }
    .destaques {
      padding-top: 1rem;
      border-top: 1px solid var(--creme-forte);
    }
    .destaques h2 {
      text-align: center;
      color: var(--marrom);
      margin-bottom: 1.5rem;
    }
    .cards {
      display: grid;
      gap: 1.25rem;
    }
    .card {
      display: block;
      background: white;
      border-radius: 18px;
      padding: 1.5rem;
      text-decoration: none;
      color: var(--texto);
      box-shadow: 0 4px 14px rgba(58, 42, 30, 0.08);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(58, 42, 30, 0.14);
    }
    .card h3 {
      margin: 0.6rem 0 0.4rem;
      font-size: 1.15rem;
      color: var(--marrom);
    }
    .card p {
      margin: 0;
      font-size: 0.92rem;
      color: #6b5a4a;
    }
  </style>
</Layout>
